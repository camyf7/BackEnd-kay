// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
  SUPER_ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
  REFUNDED
}

enum CurrencyCode {
  BRL
  EUR
}

enum PaymentStatus {
  AUTHORIZED
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
  PENDING
}

enum SyncStatus {
  SYNCED
  PENDING_SYNC
  SYNC_FAILED
}

enum AppointmentSource {
  INTERNAL
  GOOGLE
}

model User {
  id                         String                     @id @default(cuid())
  tenantId                   String?
  email                      String                     @unique
  fullName                   String
  passwordHash               String
  role                       UserRole                   @default(CLIENT)
  defaultTimezone            String                     @default("America/Sao_Paulo")
  appointments               Appointment[]
  sessions                   Session[]
  histories                  UserHistory[]
  payments                   Payment[]
  invoices                   Invoice[]
  notifications              Notification[]
  waitlistEntries            WaitlistEntry[]
  googleCalendarConnections  GoogleCalendarConnection[]
  tenant                     Tenant?                    @relation(fields: [tenantId], references: [id])
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  deletedAt                  DateTime?
  version                    Int                        @default(1)

  @@index([tenantId])
}

model Service {
  id                String           @id @default(cuid())
  tenantId          String?
  name              String
  description       String
  durationInMinutes Int
  bufferBeforeInMin Int              @default(0)
  bufferAfterInMin  Int              @default(0)
  priceBrl          Decimal          @db.Decimal(10, 2)
  priceEur          Decimal          @db.Decimal(10, 2)
  appointments      Appointment[]
  waitlistEntries   WaitlistEntry[]
  tenant            Tenant?          @relation(fields: [tenantId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  version           Int              @default(1)

  @@index([tenantId])
}

model Availability {
  id           String    @id @default(cuid())
  tenantId     String?
  weekDay      Int
  startTime    String
  endTime      String
  isActive     Boolean   @default(true)
  timezone     String    @default("America/Sao_Paulo")
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([tenantId])
}

model BlockedDate {
  id                     String             @id @default(cuid())
  tenantId               String?
  date                   DateTime
  reason                 String
  source                 AppointmentSource  @default(INTERNAL)
  externalProvider       String?
  externalReferenceId    String?
  syncStatus             SyncStatus         @default(PENDING_SYNC)
  syncRetries            Int                @default(0)
  tenant                 Tenant?            @relation(fields: [tenantId], references: [id])
  createdAt              DateTime           @default(now())
  deletedAt              DateTime?

  @@index([tenantId, date])
}

model Appointment {
  id                    String                 @id @default(cuid())
  tenantId              String?
  userId                String
  serviceId             String
  appointmentStart      DateTime
  appointmentEnd        DateTime
  status                AppointmentStatus      @default(PENDING)
  source                AppointmentSource      @default(INTERNAL)
  cancelReason          String?
  noShow                Boolean                @default(false)
  isManualOverride      Boolean                @default(false)
  syncStatus            SyncStatus             @default(PENDING_SYNC)
  syncRetries           Int                    @default(0)
  recurrenceRule        String?
  user                  User                   @relation(fields: [userId], references: [id])
  service               Service                @relation(fields: [serviceId], references: [id])
  tenant                Tenant?                @relation(fields: [tenantId], references: [id])
  payments              Payment[]
  refunds               Refund[]
  invoices              Invoice[]
  calendarEventLinks    CalendarEventLink[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  version               Int                    @default(1)

  @@index([tenantId, appointmentStart, appointmentEnd])
}

model Payment {
  id               String               @id @default(cuid())
  tenantId         String?
  userId           String
  appointmentId    String
  amount           Decimal              @db.Decimal(10, 2)
  currency         CurrencyCode
  method           String
  isTermsAccepted  Boolean
  status           PaymentStatus        @default(PAID)
  transactionId    String?
  providerPayload  Json?
  user             User                 @relation(fields: [userId], references: [id])
  appointment      Appointment          @relation(fields: [appointmentId], references: [id])
  tenant           Tenant?              @relation(fields: [tenantId], references: [id])
  refunds          Refund[]
  invoice          Invoice?
  webhookEvents    PaymentWebhookEvent[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  version          Int                  @default(1)

  @@index([tenantId])
}

model Refund {
  id            String      @id @default(cuid())
  tenantId      String?
  paymentId     String
  appointmentId String
  amount        Decimal     @db.Decimal(10, 2)
  reason        String
  payment       Payment     @relation(fields: [paymentId], references: [id])
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  tenant        Tenant?     @relation(fields: [tenantId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([tenantId])
}

model Invoice {
  id            String      @id @default(cuid())
  tenantId      String?
  invoiceNumber String      @unique
  userId        String
  appointmentId String
  paymentId     String      @unique
  user          User        @relation(fields: [userId], references: [id])
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  payment       Payment     @relation(fields: [paymentId], references: [id])
  tenant        Tenant?     @relation(fields: [tenantId], references: [id])
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?

  @@index([tenantId])
}

model Notification {
  id          String      @id @default(cuid())
  tenantId    String?
  userId      String
  title       String
  body        String
  isRead      Boolean     @default(false)
  syncStatus  SyncStatus  @default(PENDING_SYNC)
  user        User        @relation(fields: [userId], references: [id])
  tenant      Tenant?     @relation(fields: [tenantId], references: [id])
  createdAt   DateTime    @default(now())

  @@index([tenantId])
}

model FinancialReport {
  id                      String      @id @default(cuid())
  tenantId                String?
  reportDate              DateTime
  currency                CurrencyCode
  grossAmount             Decimal     @db.Decimal(10, 2)
  paidReservations        Int
  pendingPayments         Int
  summary                 String
  weeklyGrossAmount       Decimal     @db.Decimal(10, 2) @default(0)
  monthlyGrossAmount      Decimal     @db.Decimal(10, 2) @default(0)
  noShowRate              Decimal     @db.Decimal(10, 4) @default(0)
  cancellationRate        Decimal     @db.Decimal(10, 4) @default(0)
  returningClientsRate    Decimal     @db.Decimal(10, 4) @default(0)
  occupancyRate           Decimal     @db.Decimal(10, 4) @default(0)
  averageTicket           Decimal     @db.Decimal(10, 2) @default(0)
  tenant                  Tenant?     @relation(fields: [tenantId], references: [id])
  createdAt               DateTime    @default(now())

  @@unique([tenantId, reportDate, currency])
}

model Session {
  id           String    @id @default(cuid())
  tenantId     String?
  userId       String
  token        String    @db.Text
  expiresAt    DateTime
  user         User      @relation(fields: [userId], references: [id])
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([tenantId])
}

model UserHistory {
  id          String    @id @default(cuid())
  tenantId    String?
  userId      String
  action      String
  metadata    String
  user        User      @relation(fields: [userId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

model Tenant {
  id                        String                     @id @default(cuid())
  slug                      String                     @unique
  name                      String
  logoUrl                   String?
  primaryColor              String?                    @default("#111827")
  defaultCurrency           CurrencyCode               @default(BRL)
  defaultTimezone           String                     @default("America/Sao_Paulo")
  minimumNoticeHours        Int                        @default(2)
  maximumAdvanceDays        Int                        @default(60)
  cancellationHoursLimit    Int                        @default(48)
  bookingSignalPercentage   Int                        @default(50)
  paymentMethods            String                     @default("pix,card")
  defaultBufferBeforeInMin  Int                        @default(0)
  defaultBufferAfterInMin   Int                        @default(0)
  users                     User[]
  services                  Service[]
  availability              Availability[]
  blockedDates              BlockedDate[]
  appointments              Appointment[]
  payments                  Payment[]
  refunds                   Refund[]
  invoices                  Invoice[]
  notifications             Notification[]
  financialReports          FinancialReport[]
  sessions                  Session[]
  histories                 UserHistory[]
  waitlistEntries           WaitlistEntry[]
  auditLogs                 AuditLog[]
  googleCalendarConnections GoogleCalendarConnection[]
  calendarEventLinks        CalendarEventLink[]
  calendarSyncLogs          CalendarSyncLog[]
  webhookEvents             PaymentWebhookEvent[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
}

model WaitlistEntry {
  id                  String      @id @default(cuid())
  tenantId            String?
  userId              String
  serviceId           String
  preferredStartDate  DateTime
  preferredEndDate    DateTime
  status              String      @default("pending")
  user                User        @relation(fields: [userId], references: [id])
  service             Service     @relation(fields: [serviceId], references: [id])
  tenant              Tenant?     @relation(fields: [tenantId], references: [id])
  createdAt           DateTime    @default(now())

  @@index([tenantId, status])
}

model GoogleCalendarConnection {
  id                String      @id @default(cuid())
  tenantId          String?
  userId            String
  providerAccountId String
  calendarId        String
  calendarName      String
  accessToken       String
  refreshToken      String
  tokenExpiresAt    DateTime
  syncStatus        SyncStatus  @default(PENDING_SYNC)
  user              User        @relation(fields: [userId], references: [id])
  tenant            Tenant?     @relation(fields: [tenantId], references: [id])
  eventLinks        CalendarEventLink[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  @@index([tenantId, userId])
}

model CalendarEventLink {
  id                         String                    @id @default(cuid())
  tenantId                   String?
  appointmentId              String
  googleCalendarConnectionId String
  providerEventId            String
  providerEtag               String?
  externalUpdatedAt          DateTime?
  syncStatus                 SyncStatus                @default(PENDING_SYNC)
  idempotencyKey             String                    @unique
  appointment                Appointment               @relation(fields: [appointmentId], references: [id])
  googleCalendarConnection   GoogleCalendarConnection  @relation(fields: [googleCalendarConnectionId], references: [id])
  tenant                     Tenant?                   @relation(fields: [tenantId], references: [id])
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@index([tenantId, providerEventId])
}

model CalendarSyncLog {
  id                 String      @id @default(cuid())
  tenantId           String?
  calendarConnectionId String?
  eventType          String
  idempotencyKey     String
  status             SyncStatus  @default(PENDING_SYNC)
  retryCount         Int         @default(0)
  payload            Json?
  errorMessage       String?
  tenant             Tenant?     @relation(fields: [tenantId], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([tenantId, status])
}

model PaymentWebhookEvent {
  id              String      @id @default(cuid())
  tenantId        String?
  paymentId       String?
  provider        String
  eventName       String
  eventId         String
  payload         Json
  processedAt     DateTime?
  status          String      @default("pending")
  payment         Payment?    @relation(fields: [paymentId], references: [id])
  tenant          Tenant?     @relation(fields: [tenantId], references: [id])
  createdAt       DateTime    @default(now())

  @@unique([provider, eventId])
  @@index([tenantId, status])
}

model AuditLog {
  id            String      @id @default(cuid())
  tenantId      String?
  actorUserId   String?
  entityName    String
  entityId      String
  action        String
  beforeData    Json?
  afterData     Json?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([tenantId, entityName, entityId])
}
